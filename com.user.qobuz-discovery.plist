<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.user.qobuz-discovery</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string><string>python3</string>
    <string>/Users/stephen/qobuz-discovery/discover.py</string>
  </array>
  <!-- Mondays at 08:00; runs on next wake if the Mac was asleep -->
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/stephen/qobuz-discovery/out/last-run.log</string>
  <key>StandardErrorPath</key><string>/Users/stephen/qobuz-discovery/out/last-run.log</string>
</dict>
</plist>
